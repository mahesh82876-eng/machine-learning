    "import os\n",
    "import json\n",
    "import pandas as pd\n",
    "\n",
    "# CHANGE THIS TO YOUR DATASET PATH\n",
    "path = \"/kaggle/input/datasets/maheshmaaruthi/ipl-data-2-tilll-202066/ipl 2\"\n",
    "\n",
    "matches = []\n",
    "\n",
    "for file in os.listdir(path):\n",
    "\n",
    "    if file.endswith(\".json\"):\n",
    "\n",
    "        with open(os.path.join(path, file), \"r\") as f:\n",
    "            data = json.load(f)\n",
    "\n",
    "        info = data.get(\"info\", {})\n",
    "\n",
    "        teams = info.get(\"teams\", [\"\", \"\"])\n",
    "\n",
    "        toss = info.get(\"toss\", {})\n",
    "        outcome = info.get(\"outcome\", {})\n",
    "\n",
    "        matches.append({\n",
    "\n",
    "            \"Match_ID\": file.replace(\".json\",\"\"),\n",
    "\n",
    "            \"Date\": info.get(\"dates\",[None])[0],\n",
    "\n",
    "            \"Team1\": teams[0] if len(teams)>0 else None,\n",
    "\n",
    "            \"Team2\": teams[1] if len(teams)>1 else None,\n",
    "\n",
    "            \"Venue\": info.get(\"venue\"),\n",
    "\n",
    "            \"City\": info.get(\"city\"),\n",
    "\n",
    "            \"Toss_Winner\": toss.get(\"winner\"),\n",
    "\n",
    "            \"Toss_Decision\": toss.get(\"decision\"),\n",
    "\n",
    "            \"Winner\": outcome.get(\"winner\"),\n",
    "\n",
    "            \"By_Runs\": outcome.get(\"by\",{}).get(\"runs\"),\n",
    "\n",
    "            \"By_Wickets\": outcome.get(\"by\",{}).get(\"wickets\")\n",
    "\n",
    "        })\n",
    "\n",
    "df = pd.DataFrame(matches)\n",
    "\n",
    "print(df.head())\n",
    "\n",
    "print(\"\\nTotal Matches:\", len(df))\n",
    "\n",
    "df.to_csv(\"/kaggle/working/ipl_matches.csv\", index=False)\n",
    "\n",
    "print(\"\\nCSV Saved Successfully!\")"
